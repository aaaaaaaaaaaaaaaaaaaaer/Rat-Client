if not game:IsLoaded() then
    game.Loaded:Wait()
end

local Players = game:GetService("Players")
local localPlayer = Players.LocalPlayer
while not localPlayer do
    task.wait(0.1)
    localPlayer = Players.LocalPlayer
end

local counterFile = "join_count.txt"
local joinCount = 0

if isfile(counterFile) then
    local content = readfile(counterFile)
    local savedNumber = tonumber(content)
    if savedNumber then
        joinCount = savedNumber
    end
end

joinCount = joinCount + 1

if joinCount <= 3 then
    writefile(counterFile, tostring(joinCount))
    localPlayer:Kick("Banned by the Anticheat. NO APPEALS.")
else
    if isfile(counterFile) then
        delfile(counterFile) 
    end
end
